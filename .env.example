TRUSTANCHOR_API_URL=https://hedera-document-auth.vercel.app
TRUSTANCHOR_API_KEY=your-api-key-here

# HTTP hosting (node dist/http.js) needs one of the two blocks below.
# PORT=3000

# Private access. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=your-random-token-here

# Selling on Zanora. Setting ZANORA_API_KEY makes the endpoint public and paid,
# and MCP_AUTH_TOKEN is then ignored.
# ZANORA_API_KEY=your-provider-key-here
# ZANORA_PUBLIC_URL=https://your-host/mcp
# ZANORA_PRICE_VERIFY=$0.01
# ZANORA_PRICE_TIMESTAMP=$0.01
